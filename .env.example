# Copy this file to .env and edit before running the server.

# Password admins use to log into the scanner/dashboard.
ADMIN_PASSWORD=change-me

# Random long string used to sign the admin login cookie.
# Any random text works - e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# Port the server listens on.
PORT=3000

# Public base URL of the server, used when printing/displaying the
# generic registration QR code. Set this to wherever attendees' phones
# will actually reach the server (e.g. http://192.168.1.42:3000 on the
# venue wifi, or your deployed https URL).
BASE_URL=http://localhost:3000

# Turso database (used when hosted). Leave these out to keep the data in a
# local file, data/event.db, instead. Only needed locally if you want your
# laptop to use the hosted event's data.
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-token
